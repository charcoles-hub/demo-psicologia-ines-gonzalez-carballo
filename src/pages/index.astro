---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ines from '../assets/images/ines.webp';
import actual from '../assets/images/web-actual.jpg';
import propuesta from '../assets/images/propuesta.png';

const fotos = import.meta.glob('../assets/images/eq-*.webp', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const foto = (k: string) => fotos[`../assets/images/eq-${k}.webp`];

const tel = '653 42 10 63';
const wa = 'https://wa.me/34653421063?text=Hola%2C%20me%20gustar%C3%ADa%20tener%20m%C3%A1s%20informaci%C3%B3n%20sobre%20las%20consultas%20de%20psicolog%C3%ADa%20por%20favor';

const servicios = [
  ['Psicología adultos', 'Depresión, ansiedad, angustia, estrés, baja autoestima, déficit de habilidades sociales, insatisfacción personal y profesional, insomnio, trastornos de la conducta alimentaria, trastorno obsesivo compulsivo, problemas de adaptación, duelo, crisis.'],
  ['Psicología adolescentes', 'Alteraciones del estado de ánimo, ansiedad, fobia social, timidez, anorexia, bulimia, consumo de sustancias, desmotivación, orientación vocacional, sexualidad, autoimagen, autoestima.'],
  ['Psicólogo infantil', 'Miedos y fobias infantiles, rabietas, problemas de comportamiento, tristeza, angustia, acoso escolar, timidez, alteraciones del sueño, dificultades de aprendizaje, fracaso escolar, TDAH.'],
  ['Terapia de pareja', 'Problemas de comunicación, celos patológicos, discusiones frecuentes, rutina y monotonía, infidelidad, dificultades de convivencia, rupturas y separaciones, relaciones tóxicas, dependencia emocional, problemas sexuales.'],
  ['Terapia de familia', 'Relaciones paterno-filiales, relaciones entre hermanos, crisis marital, espirales de conflicto, dinámicas problemáticas, ambiente conflictivo, falta de expresión de afecto, distanciamiento.'],
  ['Coaching', 'Crecimiento y desarrollo personal, autorrealización, autoconocimiento, conseguir objetivos, inteligencia emocional, perfeccionar habilidades.'],
  ['Psicología online', 'Las mismas áreas que en consulta presencial. Se pide cita por teléfono, el pago es por transferencia y la sesión se hace por teléfono, Skype o videollamada de WhatsApp.'],
  ['Nutrición', 'Pérdida o ganancia de peso, reeducación nutricional, nutrición pediátrica, psiconutrición, nutrición deportiva, nutrición gestacional, trastornos de la alimentación, nutrición online.'],
];

const equipo = [
  ['nuria', 'Nuria Gutiérrez Cuesta', 'Psicóloga y psicoterapeuta', 'Psicología de la salud en población adulta y adolescencia'],
  ['eva', 'Eva Fernández de la Fuente', 'Psicóloga y psicoterapeuta', 'Población adulta e infanto-juvenil'],
  ['silvia', 'Silvia Hernansanz Martínez', 'Psicóloga y psicoterapeuta', 'Población adulta e infanto-juvenil'],
  ['isabel', 'Isabel Burgoa Ripoll', 'Psicóloga y psicoterapeuta', 'Población adulta e infanto-juvenil'],
  ['jaime', 'Jaime Rodríguez Cueto', 'Psicólogo y psicoterapeuta', 'Población adulta e infanto-juvenil'],
  ['elena', 'Elena González Astorga', 'Psicóloga y psicoterapeuta', 'Población adulta e infanto-juvenil'],
  ['irene', 'Irene Ruiz Paz', 'Psicóloga y psicoterapeuta', 'Población adulta e infanto-juvenil'],
  ['debora', 'Débora Paredes Benítez', 'Psicóloga y psicoterapeuta', 'Población adulta e infanto-juvenil'],
  ['maria', 'María Herrero Álvarez', 'Psicóloga y psicoterapeuta', 'Población adulta e infanto-juvenil'],
  ['sara', 'Sara Aguado García', 'Psicóloga y psicoterapeuta', 'Población adulta e infanto-juvenil'],
  ['teresa', 'Teresa Aguarón García', 'Psicóloga y psicoterapeuta', 'Población adulta e infanto-juvenil'],
  ['angela', 'Ángela Alfonsín Benavent', 'Psicóloga y psicoterapeuta', 'Población adulta e infanto-juvenil'],
  ['lidia', 'Lidia Diez Gallego', 'Psicóloga y psicoterapeuta', 'Población adulta e infanto-juvenil'],
  ['celia', 'Celia Sánchez Centeno', 'Nutricionista-dietista', 'Nutrición clínica, pediátrica, deportiva y gestacional'],
];

const tarifas = [
  ['Consulta de valoración inicial', 'Presencial. No aplicable a consultas online ni de tratamiento', '0 €'],
  ['Terapia adultos', 'Sesión de 50 minutos', '65 €'],
  ['Terapia infanto-juvenil', 'Sesión de 50 minutos', '65 €'],
  ['Terapia de pareja', 'Sesión de 50 minutos', '75 €'],
  ['Terapia de familia', 'Sesión de 50 minutos', '75 €'],
  ['Terapia online', 'Sesión de 50 minutos', '65 €'],
  ['Coaching', 'Sesión de 50 minutos', '65 €'],
  ['Consulta de urgencias', 'Sujeto a disponibilidad. Sesión de 50 minutos', '80 €'],
];

const opiniones = [
  ['Fue un privilegio ponerme en sus manos y gracias a ella puedo hacer “vida normal” saliendo de casa y disfrutando de la vida.', 'L.H.'],
  ['Llevé a mi hijo pequeño para tratar una fobia a los autobuses y en tres meses lo había superado. Fue un alivio para todos ver su evolución y implicarnos con él.', 'Anónimo'],
  ['Por fin mi pareja y yo nos entendimos y solucionamos una etapa de reproches y ansiedad en pareja.', 'C.N.'],
  ['Harta de todo decidí no posponerlo más y hacer terapia para poner punto y final a esta pesadilla.', 'H.H.U.'],
  ['Un diez para la terapia por su eficacia y profundidad, un diez para Inés por su excelencia profesional y un diez para mí por haber acudido y haber realizado el proceso completo.', 'S.S.N.'],
  ['Recomendaría acudir al Gabinete porque está cercano de líneas de comunicación, porque te atienden bien, porque la terapia es bastante efectiva y porque es un sitio serio y homologado.', 'Anónimo'],
];

const medios = ['Pareja', 'Ansiedad', 'Autoestima', 'Duelo', 'Paro', 'Redes sociales', 'Dependencia emocional', 'Deberes escolares infantiles'];
---

<Layout
  title="Psicólogos en Valladolid · Gabinete Inés González Carballo"
  description="Gabinete de psicología con dos clínicas en el Paseo Zorrilla de Valladolid. Primera consulta presencial gratuita. Teléfono 653 42 10 63."
>
  <div class="sticky top-0 z-30">
    <div class="cinta">
      <p><span class="cinta-tag">Demo</span> <span class="md:hidden">Propuesta de diseño, no es la web definitiva</span><span class="hidden md:inline">Propuesta de diseño para el Gabinete de Psicología Inés González Carballo, no es su web definitiva.</span></p>
      <a href="https://sergiogarciaweb.com" rel="noopener"><span class="md:hidden">Sergio García · Hablamos</span><span class="hidden md:inline">Preparada por Sergio García · ¿Te gusta? Hablamos</span></a>
    </div>
    <header class="border-b border-linea bg-fondo/95 backdrop-blur">
      <div class="wrap flex items-center justify-between gap-4 py-2">
        <a href="#inicio" class="flex items-center gap-3 no-underline">
          <span class="mono" aria-hidden="true">IGC</span>
          <span class="font-display text-base leading-tight sm:text-lg">Gabinete de Psicología<br /><span class="text-suave">Inés González Carballo</span></span>
        </a>
        <nav aria-label="Principal" class="hidden items-center gap-6 text-[0.95rem] lg:flex">
          <a href="#servicios" class="hover:text-acento">Servicios</a>
          <a href="#equipo" class="hover:text-acento">Equipo</a>
          <a href="#tarifas" class="hover:text-acento">Tarifas</a>
          <a href="#opiniones" class="hover:text-acento">Opiniones</a>
          <a href="#contacto" class="hover:text-acento">Contacto</a>
        </nav>
        <a href="tel:+34653421063" class="btn btn-p hidden sm:inline-flex">Llamar al {tel}</a>
      </div>
    </header>
  </div>

  <main id="inicio">
    <section class="hero">
      <div class="aura" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="wrap grid items-center gap-10 py-12 md:grid-cols-[1.15fr_0.85fr] md:py-20">
        <div class="entrada">
          <h1 class="text-[clamp(2.6rem,1.8rem+4vw,5rem)]">Psicólogos en Valladolid</h1>
          <p class="mt-6 max-w-xl text-xl text-suave">
            Un equipo de 13 psicólogos y psicólogas colegiados en dos clínicas del Paseo Zorrilla.
            <strong class="font-semibold text-tinta">La primera consulta presencial es gratuita:</strong> valoramos tus necesidades y planteamos un plan de tratamiento personalizado.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="tel:+34653421063" class="btn btn-p">Llamar al {tel}</a>
            <a href={wa} class="btn btn-s" rel="noopener">Escribir por WhatsApp</a>
          </div>
          <p class="mt-6 text-sm text-suave">Teléfono de lunes a viernes de 8:00 a 22:00. WhatsApp de lunes a domingo.</p>
        </div>
        <div class="entrada d2 mx-auto w-full max-w-sm md:max-w-none">
          <div class="cifras">
            <div class="cifra-g"><b data-count="4.8" data-dec="1">4,8</b><span>en Google, con <span data-count="270">270</span> reseñas</span></div>
            <div><b data-count="13">13</b><span>psicólogos y psicólogas</span></div>
            <div><b data-count="2">2</b><span>clínicas en el Paseo Zorrilla</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="wrap py-10 md:py-16" aria-labelledby="comp-t">
      <h2 id="comp-t" class="h2 max-w-2xl rv">De su web actual a esta propuesta</h2>
      <p class="mt-3 max-w-2xl text-suave rv">Mismos contenidos, mismo teléfono, otra primera impresión. Arrastra el deslizador.</p>
      <div class="comp rv" id="comp">
        <div class="comp-capa">
          <Image src={propuesta} alt="Propuesta de diseño: portada de esta demo" width={1440} height={900} class="comp-img" />
        </div>
        <div class="comp-capa comp-actual">
          <Image src={actual} alt="Web actual del gabinete, inesgonzalezcarballo.com" width={800} height={500} class="comp-img" />
        </div>
        <span class="comp-et comp-et-a">Su web actual</span>
        <span class="comp-et comp-et-p">Esta propuesta</span>
        <div class="comp-asa" aria-hidden="true"><span></span></div>
        <input type="range" min="0" max="100" value="50" class="comp-rango" aria-label="Comparar su web actual con esta propuesta" />
      </div>
    </section>

    <section id="servicios" class="border-t border-linea bg-superficie/60 py-16 md:py-24">
      <div class="wrap">
        <h2 class="h2 max-w-2xl rv">Qué trabajamos</h2>
        <p class="mt-4 max-w-2xl text-suave">Para cada edad y cada situación: individual, de pareja, familiar u online.</p>
        <div class="mt-10">
          {servicios.map(([t, d]) => (
            <div class="fila rv"><h3 class="text-2xl">{t}</h3><p class="text-suave">{d}</p></div>
          ))}
        </div>
      </div>
    </section>

    <section class="wrap py-16 md:py-24">
      <div class="grid gap-10 md:grid-cols-[0.8fr_1.2fr]">
        <div>
          <h2 class="h2">Cómo empieza todo</h2>
          <p class="mt-4 text-suave">Tratamiento basado fundamentalmente en el modelo cognitivo-conductual, adaptado a cada persona.</p>
        </div>
        <ol class="space-y-6">
          <li class="border-l-2 border-acento pl-5"><h3 class="text-xl">Primera consulta gratuita</h3><p class="mt-1 text-suave">Una o varias entrevistas iniciales con historia clínica y exposición de lo que te trae. La valoración permite ver si hace falta tratamiento o derivar a otro profesional. A veces una consulta es suficiente.</p></li>
          <li class="border-l-2 border-acento pl-5"><h3 class="text-xl">Plan de tratamiento</h3><p class="mt-1 text-suave">Sesiones de psicoterapia individualizada adaptadas a tus necesidades, con terapia familiar o de pareja cuando se requiere.</p></li>
          <li class="border-l-2 border-acento pl-5"><h3 class="text-xl">Revisiones periódicas</h3><p class="mt-1 text-suave">Evaluación continua de tu evolución, siempre orientada a tu bienestar y calidad de vida.</p></li>
        </ol>
      </div>
    </section>

    <section id="equipo" class="border-t border-linea py-16 md:py-24">
      <div class="wrap">
        <h2 class="h2 max-w-2xl">Las personas del gabinete</h2>
        <p class="mt-4 max-w-2xl text-suave">Psicólogas y psicólogos titulados y colegiados, con habilitación sanitaria, y una nutricionista-dietista. Inés y David Esteban Yáñez, director ejecutivo, son cofundadores y coordinan el gabinete juntos.</p>
        <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-5">
          {equipo.map(([k, n, r, e]) => (
            <li class="persona rv">
              <Image src={foto(k)} alt={n} width={310} height={387} loading="lazy" class="aspect-[4/5] w-full rounded-2xl object-cover" />
              <h3 class="mt-3 font-display text-lg leading-snug">{n}</h3>
              <p class="text-sm font-semibold text-acento">{r}</p>
              <p class="text-sm text-suave">{e}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg-tinta py-16 text-fondo md:py-24">
      <div class="wrap grid gap-10 md:grid-cols-2">
        <div>
          <div class="flex items-center gap-5">
            <Image src={ines} alt="Inés González Carballo, directora del gabinete" width={150} height={150} class="size-[150px] shrink-0 rounded-full object-cover object-top" />
            <h2 class="h2">Inés González Carballo</h2>
          </div>
          <ul class="mt-6 space-y-3 text-[#d4e2e0]">
            <li>Doctor Philosophy in Clinical Psychology por la Universidad Internacional de Cambridge.</li>
            <li>Psicóloga colegiada por el Colegio de Psicólogos de Castilla y León (CL-04129) y con Registro Sanitario.</li>
            <li>Miembro de la Asociación Nacional de Psicólogos Clínicos y Sanitarios (ANPCS) y de la Asociación Española de Psicología Clínica y Psicopatología (AEPCP).</li>
            <li>Prácticum en la Unidad de Psiquiatría y Psicología Clínica del Hospital Universitario Río Hortega de Valladolid.</li>
            <li>Máster en Psicología Clínica y Psicopatología, formación psicoanalítica y psicóloga-analista en medios de comunicación regionales y nacionales.</li>
          </ul>
        </div>
        <div>
          <h3 class="text-2xl">En los medios</h3>
          <p class="mt-3 text-[#d4e2e0]">Algunas de las intervenciones de Inés en medios de comunicación han tratado de:</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {medios.map((m) => <li class="rounded-full border border-[#4f6f75] px-4 py-1.5 text-sm">{m}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section id="tarifas" class="wrap py-16 md:py-24">
      <div class="grid gap-10 md:grid-cols-[0.8fr_1.2fr]">
        <div>
          <h2 class="h2">Tarifas</h2>
          <p class="mt-4 text-suave">Bonos de 10 sesiones con un 10 % de descuento y de 20 sesiones con un 20 %.</p>
          <a href="tel:+34653421063" class="btn btn-p mt-6">Pedir cita: {tel}</a>
        </div>
        <div class="border-b border-linea">
          {tarifas.map(([t, d, p]) => (
            <div class="tarifa rv"><div><h3 class="font-cuerpo text-lg font-semibold tracking-normal">{t}</h3><p class="text-sm text-suave">{d}</p></div><b>{p}</b></div>
          ))}
        </div>
      </div>
    </section>

    <section id="opiniones" class="border-t border-linea bg-superficie/60 py-16 md:py-24">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="h2">Lo que cuentan quienes vinieron</h2>
          <p class="text-suave"><strong class="font-display text-3xl font-medium text-tinta">4,8</strong> en Google · 270 reseñas</p>
        </div>
        <p class="mt-3 text-sm text-suave">Testimonios de la web del gabinete, firmados solo con iniciales para proteger la identidad de cada paciente.</p>
        <div class="mt-10 columns-1 gap-6 md:columns-2">
          {opiniones.map(([t, a]) => (
            <figure class="rv mb-6 break-inside-avoid rounded-2xl bg-fondo p-6">
              <blockquote class="font-display text-xl leading-snug">“{t}”</blockquote>
              <figcaption class="mt-4 text-sm font-semibold text-acento">{a}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="contacto" class="wrap py-16 md:py-24">
      <h2 class="h2 max-w-2xl">Dos clínicas en el Paseo Zorrilla</h2>
      <div class="mt-10 grid gap-10 md:grid-cols-2">
        <div class="space-y-6">
          <div>
            <h3 class="text-xl">Paseo Zorrilla 34, 1º Der.</h3>
            <p class="text-suave">47006 Valladolid. En el tramo final del Campo Grande, muy cerca de la Plaza Zorrilla.</p>
            <a class="text-acento" href="https://www.google.com/maps/search/?api=1&query=Paseo+Zorrilla+34+Valladolid" rel="noopener">Ver en Google Maps</a>
          </div>
          <div>
            <h3 class="text-xl">Paseo Zorrilla 48, 3º A</h3>
            <p class="text-suave">47006 Valladolid. Enfrente del Hospital Militar, entre el final del Campo Grande y el inicio de Cines Broadway.</p>
            <a class="text-acento" href="https://www.google.com/maps/search/?api=1&query=Paseo+Zorrilla+48+Valladolid" rel="noopener">Ver en Google Maps</a>
          </div>
          <div>
            <h3 class="text-xl">Cómo llegar</h3>
            <p class="text-suave">A 2 minutos de varias líneas de Auvasa, a menos de 5 de la estación de autobuses y a 10 de la estación de trenes. Aparcamientos cercanos: Plaza Zorrilla (5 min a pie), Casa de las Indias (7 min) y Colón (9 min).</p>
          </div>
        </div>
        <div class="rounded-3xl bg-acento p-8 text-white">
          <h3 class="text-3xl">Pide tu primera consulta gratuita</h3>
          <p class="mt-3 text-[#e3f0ee]">Consultas de lunes a viernes de 8:00 a 22:00.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="tel:+34653421063" class="btn bg-white !text-acento-fuerte hover:bg-superficie">Llamar al {tel}</a>
            <a href={wa} class="btn border-[1.5px] border-white text-white hover:bg-white hover:!text-acento-fuerte" rel="noopener">WhatsApp</a>
          </div>
          <p class="mt-6 text-[#e3f0ee]">O escribe a <a class="inline-block py-3 font-semibold underline" href="mailto:igc.direccion@gmail.com">igc.direccion@gmail.com</a></p>
        </div>
      </div>
    </section>

    <section class="bg-tinta py-14 text-fondo" style="border-top:1px solid #2c4a52">
      <div class="wrap flex flex-wrap items-center justify-between gap-6">
        <div class="max-w-2xl">
          <h2 class="h2">¿Te gusta esta propuesta? Hablamos</h2>
          <p class="mt-3 text-[#d4e2e0]">Es una demo de diseño preparada por Sergio García, sin compromiso. Si quieres verla con tus cambios o llevarla a tu dominio, escríbeme.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="tel:+34620650597" class="btn bg-white !text-acento-fuerte hover:bg-superficie">Llamar al 620 650 597</a>
          <a href="https://sergiogarciaweb.com" class="btn border-[1.5px] border-white text-white hover:bg-white hover:!text-acento-fuerte" rel="noopener">sergiogarciaweb.com</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-linea py-8 text-sm text-suave">
    <div class="wrap">
      <p>Gabinete de Psicología e Instituto de Salud Inés González Carballo, Ph.D. · Registros Sanitarios 47-C22-0314 y 47-C24-0112.</p>
      <p class="mt-2">Esto es una propuesta de rediseño, no la web oficial. La web actual del gabinete es inesgonzalezcarballo.com.</p>
    </div>
  </footer>

  <div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-linea bg-fondo p-2 md:hidden">
    <a href="tel:+34653421063" class="btn btn-p">Llamar</a>
    <a href={wa} class="btn btn-s" rel="noopener">WhatsApp</a>
  </div>
</Layout>
